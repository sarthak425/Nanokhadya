# NanoTech Food Safety System — Backend Environment Configuration
# Copy this to .env and adjust values for your environment.

# -----------------------------------------------------------------
# DATA SOURCE
# -----------------------------------------------------------------
# BLE       → Real AS7265x + ESP32 via Bluetooth Low Energy
# DEVELOPMENT → Synthetic spectral data generator (no hardware needed)
DATA_SOURCE=DEVELOPMENT

# -----------------------------------------------------------------
# BLE CONFIGURATION (used when DATA_SOURCE=BLE)
# -----------------------------------------------------------------
# Target device name prefix broadcast by the ESP32
BLE_DEVICE_NAME_PREFIX=NanoTech-FS
# These UUIDs must match your ESP32 firmware. Update when firmware is finalized.
BLE_SERVICE_UUID=12345678-1234-1234-1234-123456789abc
BLE_SENSOR_CHAR_UUID=12345678-1234-1234-1234-123456789abd
BLE_CONTROL_CHAR_UUID=12345678-1234-1234-1234-123456789abe
BLE_STATUS_CHAR_UUID=12345678-1234-1234-1234-123456789abf
BLE_SCAN_TIMEOUT_SECONDS=10
BLE_CONNECTION_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/nanotech.db

# -----------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------
APP_NAME=NanoTech Food Safety System
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------
# MODEL STORAGE
# -----------------------------------------------------------------
MODEL_STORAGE_PATH=./data/models
DATASET_STORAGE_PATH=./data/datasets
